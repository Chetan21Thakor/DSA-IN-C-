# Ignore compiled object files and build artifacts
*.o
*.obj
*.lo
*.la
*.al

# Ignore libraries and binaries
*.exe
*.out
*.app
*.lib
*.a
*.dll
*.so
*.dylib

# Ignore debug and temporary files
*.pdb
*.ilk
*.gch
*.pch
*.dSYM/
*.tmp
*.temp
*~
*.swp
*.swo

# Ignore build directories
/build/
/bin/
/Debug/
/Release/
/x64/
/x86/
/CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Ignore editor and OS files
.vscode/
*.code-workspace
Thumbs.db
.DS_Store

